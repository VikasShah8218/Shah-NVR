# ---------------- Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------------- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=2024
DB_NAME=nvr

# ---------------- Node health / ownership
HEARTBEAT_TIMEOUT_SECONDS=15
LEASE_TTL_SECONDS=30
FAILOVER_GRACE_SECONDS=10

# ---------------- Background loops
SCHEDULER_INTERVAL_SECONDS=5
HEALTH_INTERVAL_SECONDS=5
RETENTION_INTERVAL_SECONDS=600

# ---------------- Recording / playback
DEFAULT_RETENTION_DAYS=7
PLAYBACK_GAP_TOLERANCE_SECONDS=2
PLAYBACK_MAX_HOURS=24
# Maximum interval accepted by one export job and how long completed files remain downloadable.
EXPORT_MAX_HOURS=4
EXPORT_FILE_TTL_HOURS=24

# ---------------- Authentication (docs/AUTH_INTEGRATION_PLAN.md)
# false = open API (today's behaviour); true = Auth Server access tokens required
AUTH_ENABLED=false
AUTH_SERVER=http://localhost:5082
AUTH_APP_KEY=SNVR
AUTH_CLIENT_ID=SNVR
# Downstream service secret from the Auth Console (never commit it)
AUTH_CLIENT_SECRET=
# Auth Server user-token signing secret (HS256; never commit it)
AUTH_KEY=
AUTH_STATE_BACKEND=memory
AUTH_FAIL_MODE=closed
# Which Auth Server (docs/AUTH_V2_PLAN.md): legacy = the settings above | oidc = the new Auth Server (auth_sdk)
AUTH_PROVIDER=legacy
# --- oidc only. Needs: pip install -e <Auth-Server>/sdk   (auth-sdk 0.3.0+)
AUTH_ISSUER=http://localhost:5181
# where central reaches the Auth Server API when that differs from the issuer (empty = issuer)
AUTH_API_URL=
# confidential server client (scopes events.read permissions.read users.read); never commit the secret
AUTH_OIDC_CLIENT_ID=snvr-a
AUTH_OIDC_CLIENT_SECRET=
AUTH_WEB_CLIENT_ID=snvr-web
AUTH_DESKTOP_CLIENT_ID=snvr-desktop
AUTH_STATE_PATH=./data/auth-state.json
AUTH_INSTANCE_ID=
AUTH_MAX_STALENESS_SECONDS=0
AUDIT_RETENTION_DAYS=365
