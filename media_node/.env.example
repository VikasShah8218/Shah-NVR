# ---------------- Identity / API
NODE_NAME=node-1
HOST=0.0.0.0
PORT=7100
# IP/host that VLC, browsers and the central manager use to reach THIS node
PUBLIC_HOST=127.0.0.1
CAPACITY_CAMERAS=100
LOG_LEVEL=INFO

# ---------------- Central manager
CENTRAL_URL=http://127.0.0.1:8000

# ---------------- Storage (relative paths are relative to this folder)
DATA_DIR=./data
RECORDINGS_DIR=./data/recordings
EXPORTS_DIR=./data/exports
# Export jobs refuse to start if the export disk would fall below this safety reserve.
EXPORT_MIN_FREE_BYTES=1073741824

# ---------------- MediaMTX (change ports when running 2 nodes on one PC)
MEDIAMTX_BIN=./bin/mediamtx.exe
# Required for recorded audio listening when a camera records G.711/LPCM.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Completed export files are removed from the node after this many hours.
EXPORT_FILE_TTL_HOURS=24
MEDIAMTX_API_PORT=9997
MEDIAMTX_METRICS_PORT=9998
RTSP_PORT=8554
RTP_PORT=8000
RTCP_PORT=8001
HLS_PORT=8888
HLS_VARIANT=lowLatency
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189

# ---------------- Recording
SEGMENT_SECONDS=60
PART_SECONDS=1
HLS_PART_TARGET_SECONDS=4

# ---------------- Disk protection
DISK_MAX_USED_PERCENT=95
DISK_TARGET_USED_PERCENT=92
DISK_MIN_KEEP_HOURS=1


# -----------------
ONVIF_SERVER_USERNAME=shah
ONVIF_SERVER_PASSWORD=shah
ONVIF_RTSP_PORT=8555
