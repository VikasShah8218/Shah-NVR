# ---------------- Identity / API
NODE_NAME=node-1
HOST=0.0.0.0
PORT=7100
# IP/host put into every client link (VLC, browsers).
# auto = this PC's LAN IP (e.g. 192.168.1.3). VPN and virtual adapter addresses are never used.
PUBLIC_HOST=auto
CAPACITY_CAMERAS=100
LOG_LEVEL=INFO

# ---------------- Central manager
CENTRAL_URL=http://127.0.0.1:8000

# ---------------- Storage (relative paths are relative to this folder)
DATA_DIR=./data
RECORDINGS_DIR=./data/recordings

# ---------------- MediaMTX (change ports when running 2 nodes on one PC)
MEDIAMTX_BIN=./bin/mediamtx.exe
MEDIAMTX_API_PORT=9997
MEDIAMTX_METRICS_PORT=9998
RTSP_PORT=8554
RTP_PORT=8000
RTCP_PORT=8001
HLS_PORT=8888
HLS_VARIANT=lowLatency
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189

# ---------------- Recording
SEGMENT_SECONDS=60
PART_SECONDS=1
HLS_PART_TARGET_SECONDS=4

# ---------------- Disk protection
DISK_MAX_USED_PERCENT=95
DISK_TARGET_USED_PERCENT=92
DISK_MIN_KEEP_HOURS=1

# ---------------------------------------------------------------- Storage volumes
# Extra drives / network shares are added in the central manager (node -> Storage tab).
# RECORDINGS_DIR above is always the node's own (default) volume.
# Network shares: save their login once on this PC, as the Windows user that runs the node:
#   cmdkey /add:<host> /user:<user> /pass:<password>      and use the \\host\share\folder path
STORAGE_CHECK_INTERVAL_SECONDS=10
