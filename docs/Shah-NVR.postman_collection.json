{
  "info": {
    "name": "Shah-NVR",
    "description": "Central Manager + Media Node APIs. Set {{central}}, {{node}}, {{camera_id}}, {{node_id}} in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "central",
      "value": "http://localhost:8000"
    },
    {
      "key": "node",
      "value": "http://localhost:7100"
    },
    {
      "key": "camera_id",
      "value": "1"
    },
    {
      "key": "node_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Cameras",
      "item": [
        {
          "name": "Create camera",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/cameras"
            },
            "description": "Simulator URLs by default; replace with real camera RTSP URLs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gate Camera\",\n  \"username\": \"admin\",\n  \"password\": \"secret\",\n  \"retention_days\": 7,\n  \"streams\": [\n    {\n      \"profile\": \"main\",\n      \"source_url\": \"rtsp://127.0.0.1:8654/sim-1\",\n      \"record\": true\n    },\n    {\n      \"profile\": \"sub\",\n      \"source_url\": \"rtsp://127.0.0.1:8654/sim-2\",\n      \"record\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List cameras",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cameras"
            },
            "description": ""
          }
        },
        {
          "name": "Get camera (status + assignment)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}"
            },
            "description": ""
          }
        },
        {
          "name": "Update camera",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gate Camera 1\",\n  \"retention_days\": 14\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Disable camera (stops recording)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Enable camera",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add stream profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}/streams"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": \"third\",\n  \"source_url\": \"rtsp://127.0.0.1:8654/sim-2\",\n  \"record\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update stream profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}/streams/sub"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"record\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete stream profile",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}/streams/third"
            },
            "description": ""
          }
        },
        {
          "name": "Delete camera (only without recordings)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Live",
      "item": [
        {
          "name": "Live URLs (RTSP / HLS / WebRTC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}/live"
            },
            "description": "Open the rtsp or hls URL in VLC."
          }
        }
      ]
    },
    {
      "name": "Recordings & Playback",
      "item": [
        {
          "name": "Timeline - last 60 minutes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}/recordings?profile=main&minutes=60"
            },
            "description": ""
          }
        },
        {
          "name": "Timeline - range (UTC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cameras/{{camera_id}}/recordings?profile=main&start=2026-10-12T00:00:00Z&end=2026-10-12T01:00:00Z"
            },
            "description": ""
          }
        },
        {
          "name": "HLS playlist - last 10 minutes (open URL in VLC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/playback/{{camera_id}}/index.m3u8?profile=main&minutes=10"
            },
            "description": ""
          }
        },
        {
          "name": "HLS playlist - range (open URL in VLC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/playback/{{camera_id}}/index.m3u8?profile=main&start=2026-10-12T00:00:00Z&end=2026-10-12T01:00:00Z"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Media Nodes",
      "item": [
        {
          "name": "List nodes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/nodes"
            },
            "description": ""
          }
        },
        {
          "name": "Get node",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/nodes/{{node_id}}"
            },
            "description": ""
          }
        },
        {
          "name": "Set capacity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/nodes/{{node_id}}"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity_cameras\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Drain (move all cameras away)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/nodes/{{node_id}}/drain"
            },
            "description": ""
          }
        },
        {
          "name": "Cordon (no new cameras)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/nodes/{{node_id}}/cordon"
            },
            "description": ""
          }
        },
        {
          "name": "Activate (normal scheduling)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/nodes/{{node_id}}/activate"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "List assignments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/assignments"
            },
            "description": ""
          }
        },
        {
          "name": "Move camera to node",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{central}}/api/v1/assignments/{{camera_id}}"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"node_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Assignment history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/assignments/{{camera_id}}/history"
            },
            "description": ""
          }
        },
        {
          "name": "Run scheduler now",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/assignments/run-scheduler"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Cluster",
      "item": [
        {
          "name": "Cluster health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{central}}/api/v1/cluster/health"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Media Node (direct)",
      "item": [
        {
          "name": "Node status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node}}/api/v1/status"
            },
            "description": ""
          }
        },
        {
          "name": "Node assignments (cached)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node}}/api/v1/assignments"
            },
            "description": ""
          }
        },
        {
          "name": "MediaMTX live paths",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node}}/api/v1/mediamtx/paths"
            },
            "description": ""
          }
        },
        {
          "name": "Local chunks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{node}}/api/v1/segments?limit=20"
            },
            "description": ""
          }
        }
      ]
    }
  ]
}