# First-run defaults only. Once the app has started, the central URL and every other choice are
# changed in Settings inside the app (stored per Windows user, not in this file).
CENTRAL_URL=http://localhost:8000
LOG_LEVEL=INFO
# Folder that contains libmpv-2.dll (relative paths are relative to nvr_desktop/)
MPV_DLL_DIR=bin
HTTP_TIMEOUT_SECONDS=10
# Force video rendering (cpu | gpu) regardless of Settings in the app; leave empty normally
RENDER_MODE=
